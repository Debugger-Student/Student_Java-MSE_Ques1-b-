      "name": "Add Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"S104\",\n  \"studentName\": \"Neha Sharma\",\n  \"email\": \"neha@example.com\",\n  \"courseName\": \"B.Tech CSIT\",\n  \"programmingScore\": 82,\n  \"mathematicsScore\": 90,\n  \"technicalSkills\": [\n    \"Java\",\n    \"SQL\",\n    \"Python\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
